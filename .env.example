# Copia este archivo como .env.local y rellena los valores (nunca subas .env.local a git).

# URL del proyecto: Supabase → Project Settings → API. No es secreta.
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave SECRETA (sb_secret_...) o, en proyectos antiguos, la service_role.
# Solo la usa el servidor. NUNCA le pongas el prefijo NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# La app no tiene autenticación: en producción (next start) la carga queda
# bloqueada salvo que actives esto. Antes de publicarla, añade autenticación.
# ETL_PERMITIR_ESCRITURA_SIN_AUTH=true

# Clave de MapTiler para el mapa (https://cloud.maptiler.com/account/keys/).
# Es pública (llega al navegador): restringe sus dominios en MapTiler.
NEXT_PUBLIC_MAPTILER_KEY=
